		<field xsi:type="DataSetFieldField">
			<dataPath>ПланВсего</dataPath>
			<field>ПланВсего</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>План всего</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ФактВсего</dataPath>
			<field>ФактВсего</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Факт всего</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Начислено</dataPath>
			<field>Начислено</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Начислено</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Данные.Клиент КАК Клиент,
	Данные.Договор КАК Договор,
	СУММА(Данные.АбонентскаяПлата) КАК АбонентскаяПлата,
	СУММА(Данные.СуммаОбслуживание) КАК СуммаОбслуживание,
	СУММА(Данные.ПланВсего) КАК Начислено,
	СУММА(Данные.ФактВсего) КАК Выставлено,
	СУММА(Данные.ПланВсего) - СУММА(Данные.ФактВсего) КАК Долг
ИЗ
	(ВЫБРАТЬ
		ДоговорыКонтрагентов.Владелец КАК Клиент,
		ДоговорыКонтрагентов.Ссылка КАК Договор,
		ДоговорыКонтрагентов.ВКМ_АбонентскаяПлата КАК АбонентскаяПлата,
		ЕСТЬNULL(Обороты.ВКМ_СуммаКОплатеОборот, 0) КАК СуммаОбслуживание,
		ДоговорыКонтрагентов.ВКМ_АбонентскаяПлата + ЕСТЬNULL(Обороты.ВКМ_СуммаКОплатеОборот, 0) КАК ПланВсего,
		0 КАК ФактВсего
	ИЗ
		Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВКМ_ВыполненныеКлиентуРаботы.Обороты(&amp;НачалоПериода, &amp;КонецПериода,,) КАК
				Обороты
			ПО ДоговорыКонтрагентов.Ссылка = Обороты.ВКМ_Договор
	ГДЕ
		ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_Абонент)
		И НЕ ДоговорыКонтрагентов.ПометкаУдаления

	ОБЪЕДИНИТЬ ВСЕ

	ВЫБРАТЬ
		РеализацияТоваровУслуг.Контрагент,
		РеализацияТоваровУслуг.Договор,
		0,
		0,
		0,
		СУММА(РеализацияТоваровУслугУслуги.Сумма)
	ИЗ
		Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
			ПО РеализацияТоваровУслуг.Ссылка = РеализацияТоваровУслугУслуги.Ссылка
	ГДЕ
		РеализацияТоваровУслуг.Проведен
		И НАЧАЛОПЕРИОДА(РеализацияТоваровУслуг.Дата, ДЕНЬ) &gt;= НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
		И НАЧАЛОПЕРИОДА(РеализацияТоваровУслуг.Дата, ДЕНЬ) &lt;= НАЧАЛОПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	СГРУППИРОВАТЬ ПО
		РеализацияТоваровУслуг.Контрагент,
		РеализацияТоваровУслуг.Договор) КАК Данные
СГРУППИРОВАТЬ ПО
	Данные.Клиент,
	Данные.Договор</query>
	</dataSet>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>false</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>false</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
